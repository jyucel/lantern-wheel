{
  "name": "lantern-wheel",
  "version": "1.0.0",
  "description": "Lantern Wheel: a festival sorting puzzle. Spin the wheel, stack the towers, queue the piers, and sort every lantern by color.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "generate": "node tools/generate-levels.mjs",
    "test": "node --test tests/",
